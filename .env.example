# Copia este archivo como .env y rellena los valores reales.
# .env NUNCA se commitea (ver .gitignore). Solo variables VITE_* — son
# públicas por diseño (se embeben en el bundle del navegador). Ninguna
# llave secreta (service_role de Supabase, access token de Mercado Pago,
# secret key de Stripe) va aquí: esas viven solo como secretos de las
# Supabase Edge Functions.

# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mercado Pago — llave PÚBLICA (Public Key), usada solo por el SDK de checkout en el cliente
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
